{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbench",
  "mainBinaryName": "cib-workbench",
  "version": "2.0.2",
  "identifier": "com.cibeg.workbench",
  "build": {
    "beforeDevCommand": "bun tools/multiplexer.ts && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun tools/multiplexer.ts && bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Workbench",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CIB",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "CIB's internal developer workbench, based on Spagitty. MIT licence. For internal use only.",
    "shortDescription": "Developer workbench",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "windows": {
      "wix": {
        "version": "2.0.2.0"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "installer/nsis-header.bmp",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../multiplexer/bundle/": "multiplexer/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/maxmya/cib-workbench/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
